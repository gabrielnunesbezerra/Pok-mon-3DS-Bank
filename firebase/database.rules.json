{
  "rules": {
    "banks": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || auth.token.email === 'adminbielz@users.3dsbank.app')",
        ".write": "auth != null && (auth.uid === $uid || auth.token.email === 'adminbielz@users.3dsbank.app') && newData.exists() && (!data.exists() || newData.child('base').val() === data.child('revision').val())"
      }
    },
    "usernames": {
      ".read": "auth != null",
      "$name": {
        ".write": "auth != null && !data.exists() && newData.val() === auth.uid && ($name !== 'adminbielz' || auth.token.email === 'adminbielz@users.3dsbank.app')",
        ".validate": "newData.isString() && $name.length >= 3 && $name.length <= 20"
      }
    },
    "profiles": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        "username": {
          ".validate": "newData.isString() && newData.val().length <= 20"
        },
        "displayName": {
          ".validate": "newData.isString() && newData.val().length <= 20"
        },
        "bio": {
          ".validate": "newData.isString() && newData.val().length <= 80"
        },
        "favoriteNickname": {
          ".validate": "newData.isString() && newData.val().length <= 24"
        },
        "favoriteGame": {
          ".validate": "newData.isString() && newData.val().length <= 40"
        }
      }
    },
    "presence": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.isNumber()"
      }
    },
    "friendRequests": {
      "$to": {
        ".read": "auth != null && auth.uid === $to",
        "$from": {
          ".write": "auth != null && ((auth.uid === $to && !newData.exists()) || (auth.uid === $from && $from !== $to && (!newData.exists() || newData.child('username').val() === root.child('profiles').child($from).child('username').val())))"
        }
      }
    },
    "friends": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$friend": {
          ".write": "auth != null && (auth.uid === $uid || (auth.uid === $friend && (!newData.exists() || root.child('friendRequests').child($friend).child($uid).exists())))"
        }
      }
    },
    "tradeInvites": {
      "$to": {
        ".read": "auth != null && auth.uid === $to",
        "$trade": {
          ".write": "auth != null && ((auth.uid === $to && !newData.exists()) || (!newData.exists() && data.child('from').val() === auth.uid) || (newData.child('from').val() === auth.uid && root.child('friends').child($to).child(auth.uid).exists()))"
        }
      }
    },
    "trades": {
      "$trade": {
        ".read": "auth != null && (data.child('a').val() === auth.uid || data.child('b').val() === auth.uid)",
        ".write": "auth != null && !data.exists() && newData.child('a').val() === auth.uid && newData.child('state').val() === 'open' && root.child('friends').child(auth.uid).child(newData.child('b').val()).exists()",
        "state": {
          ".write": "auth != null && (data.parent().child('a').val() === auth.uid || data.parent().child('b').val() === auth.uid) && data.val() === 'open'",
          ".validate": "newData.val() === 'open' || newData.val() === 'committed' || newData.val() === 'cancelled'"
        },
        "offers": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && (data.parent().parent().child('a').val() === $uid || data.parent().parent().child('b').val() === $uid) && data.parent().parent().child('state').val() === 'open' && !data.parent().parent().child('confirm').exists()",
            ".validate": "!newData.exists() || (newData.child('data').isString() && newData.child('data').val().length < 4000)"
          }
        },
        "confirm": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && !data.exists() && data.parent().parent().child('state').val() === 'open' && data.parent().parent().child('offers').child($uid).exists()",
            ".validate": "newData.isString() && newData.val().length <= 64"
          }
        },
        "done": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && data.parent().parent().child('state').val() === 'committed'"
          }
        }
      }
    },
    "userTrades": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "parkVisits": {
      ".read": "auth != null && auth.token.email === 'adminbielz@users.3dsbank.app'",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$visit": {
          ".write": "auth != null && (auth.token.email === 'adminbielz@users.3dsbank.app' || (auth.uid === $uid && ((!data.exists() && newData.child('state').val() === 'sent' && newData.child('ownerUid').val() === $uid) || (!newData.exists() && data.child('state').val() === 'returned'))))",
          ".validate": "!newData.exists() || (newData.child('data').isString() && newData.child('data').val().length < 4000 && (newData.child('state').val() === 'sent' || newData.child('state').val() === 'caring' || newData.child('state').val() === 'returned'))"
        }
      }
    },
    "arena": {
      ".read": "auth != null",
      "event": {
        ".write": "auth != null && auth.token.email === 'adminbielz@users.3dsbank.app'"
      },
      "results": {
        "$event": {
          "$uid": {
            ".write": "auth != null && (auth.uid === $uid || auth.token.email === 'adminbielz@users.3dsbank.app')",
            ".validate": "newData.child('username').isString() && newData.child('username').val().length <= 20"
          }
        }
      }
    }
  }
}
